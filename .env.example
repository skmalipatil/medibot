# ─────────────────────────────────────────────────────────────
# medibot — environment variables
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# --- App / API ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Auth (demo JWT) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Relational DB (Phase 4 — SQL chain) ---
# Example: sqlite for local learning, or postgres for realism
DATABASE_URL=sqlite:///./data/medibot.db

# --- Ingestion ---
DATA_DIR=./data/mediassist_data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
