# ─────────────────────────────────────────────────────────────
# medibot — environment variables
# Copy this file to `.env` and fill in the real values.
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# These are exactly the variables backend/config.py reads via
# os.getenv(...) — nothing more, nothing less. Everything else
# (model names, role/collection maps, demo users, top-K values)
# is intentionally hardcoded in config.py, not environment-driven.
# ─────────────────────────────────────────────────────────────

# --- LLM (Groq — free tier) ---
GROQ_API_KEY=your-groq-api-key-here

# --- Qdrant (vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Auth (demo JWT signing key) ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Relational DB (SQL RAG) ---
DB_PATH=data/mediassist_data/db/mediassist.db
